<!-- finops_report/templates/report.html.j2 -->
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<title>FinOps Boardroom Report — {{ date }}</title>
<style>
  body { font-family: Arial, sans-serif; max-width: 900px; margin: 2em auto; padding: 0 1em; color: #1a1a2e; }
  h1 { color: #16213e; border-bottom: 2px solid #0f3460; padding-bottom: 0.3em; }
  h2 { color: #0f3460; margin-top: 2em; }
  .meta { color: #666; font-size: 0.9em; }
  .rec { background: #f8f9fa; border-left: 4px solid #0f3460; padding: 0.75em 1em; margin: 0.5em 0; }
  .savings { color: #10b981; font-weight: bold; }
  pre { background: #1e1e2e; color: #cdd6f4; padding: 1em; border-radius: 6px; overflow-x: auto; }
  table { border-collapse: collapse; width: 100%; margin: 1em 0; }
  th, td { border: 1px solid #ddd; padding: 8px; text-align: left; }
  th { background: #16213e; color: white; }
</style>
</head>
<body>
<h1>FinOps Boardroom Report</h1>
<p class="meta">Generated: {{ date }} &middot; GCP Cost Analysis</p>

<h2>Executive Summary</h2>
<p>{{ analysis.executive_summary | default("No summary available.") }}</p>

<h2>Top Cost Drivers</h2>
<table>
<tr><th>Driver</th><th>Monthly Cost</th></tr>
{% for d in analysis.get('cost_drivers', []) %}
<tr><td>{{ d.name or d.description }}</td><td>${{ d.amount if d.amount is number else '?' }}</td></tr>
{% endfor %}
</table>

<h2>Recommendations</h2>
{% for r in analysis.get('recommendations', []) | sort(attribute='priority') %}
<div class="rec">
  <strong>{{ r.title }}</strong>
  <span class="savings"> — ${{ '%.0f' % r.estimated_monthly_savings }}/mo</span>
  <span style="float:right; background:#{{ '10b981' if r.risk_level=='low' else 'f59e0b' if r.risk_level=='medium' else 'ef4444' }}; color:white; padding:2px 6px; border-radius:4px; font-size:0.8em;">{{ r.risk_level|upper }}</span>
  <p>{{ r.description }}</p>
</div>
{% endfor %}

<h2>Terraform Implementation Snippets</h2>
{% for s in analysis.get('tf_snippets', [])[:3] %}
<pre>{{ s.code if s is mapping else s }}</pre>
{% endfor %}
{% if not analysis.get('tf_snippets') %}
<p>No Terraform snippets generated for this engagement.</p>
{% endif %}
</body>
</html>